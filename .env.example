# Copy to .env.local (never commit real values) and set the same variables in Vercel > Settings > Environment Variables.

# Telegram alerts. Leave empty to turn the feature off.
# Create a bot with @BotFather to get the token, then message the bot once so its chat ID can be found.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# "scans" (default): alert when someone scans a major. "all": also alert on every new visit.
TELEGRAM_NOTIFY_MODE=scans

# Alerts only send in production. Set to 1 to test locally.
# TELEGRAM_NOTIFY_DEV=1

# Payment funnel alerts (unlock clicked, payment started, could not start, not completed). Purchase and refund alerts
# always send. Set to "off" to mute the step alerts once real traffic makes them noisy.
# TELEGRAM_PAYMENT_ALERTS=off

# Paid career plan ($4.99 one-time). Safe by default: with this unset or "off" nothing is shown and every
# payment route answers 404.
#   off  (default)  no offer
#   test            offer + a clearly marked FAKE checkout (no money moves, no keys needed). Test purchases are
#                   sent to GA4 as "test_purchase", never as "purchase".
#   live            offer + real Paystack checkout. Needs the three values below.
# This one is read by the browser too, so it is set at BUILD time: change it, then redeploy.
NEXT_PUBLIC_PAYMENTS_MODE=off

# Live mode only (server-side secrets; never prefix these with NEXT_PUBLIC_):
# From Paystack dashboard > Settings > API Keys & Webhooks. Use the sk_test_ key first, sk_live_ when ready.
PAYSTACK_SECRET_KEY=
# A long random string (32+ characters) used to sign the "this browser paid" cookie. Required in live mode.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PAYMENT_SESSION_SECRET=
# The price you charge. A Ghana Paystack account CANNOT charge in USD (only Kenya and Nigeria accounts can), so
# production uses GHS: set both. The amount is in the smallest unit (pesewas): GHS 46.90 is 4690. It is YOUR price
# decision: the code never converts or guesses a rate. The page shows exactly this price (it reads it from the same
# settings the charge uses), so changing the amount here, then redeploying, changes both. Leave both unset to charge
# USD $4.99 (only an account that can take USD).
# PAYSTACK_CURRENCY=GHS
# PAYSTACK_AMOUNT_MINOR=4690
# Optional: only for testing against a fake Paystack server.
# PAYSTACK_API_BASE=https://api.paystack.co

# Live payments: in the Paystack dashboard (Settings > API Keys & Webhooks) set the webhook URL, for Test mode and
# again for Live mode, to https://how-cooked-is-your-major.vercel.app/api/paystack/webhook
# It uses PAYSTACK_SECRET_KEY above to check that messages really come from Paystack, and sends you a Telegram
# alert for every verified purchase and refund.

# Purchase records (optional, live payments). Supabase project with the `purchases` table, Row Level Security on.
# With these set, every verified payment is saved (the email only as a keyed fingerprint), duplicate alerts stop,
# refunds block a restore, and buyers can restore with their email. Server-side secrets: never NEXT_PUBLIC_.
# SUPABASE_URL=https://<your-project>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# EMAIL_HASH_SECRET=

# Private gate (server-side secret, 16+ characters). While it is set, payments are hidden from everyone and every
# payment route answers 404, except for a browser that has opened  /api/preview?key=<this value>  once. Use it to
# test with test keys, and then with one real payment, before opening payments to the public. Paystack's webhook
# is never gated. To open payments to everyone: delete this variable and redeploy.
# PAYMENTS_PREVIEW_KEY=
