# Copy to .env.local (never commit real values) and set the same variables in Vercel > Settings > Environment Variables.

# Telegram alerts. Leave empty to turn the feature off.
# Create a bot with @BotFather to get the token, then message the bot once so its chat ID can be found.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# "scans" (default): alert when someone scans a major. "all": also alert on every new visit.
TELEGRAM_NOTIFY_MODE=scans

# Alerts only send in production. Set to 1 to test locally.
# TELEGRAM_NOTIFY_DEV=1
